{
  "name": "kglkicks-backend",
  "version": "1.0.0",
  "description": "Kigali Kicks backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
