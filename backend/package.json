    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.4",
    "pino": "^9.1.0",
    "pino-pretty": "^11.2.1",
    "dotenv": "^16.4.5",
    "citext": "^1.0.1",
    "pgcrypto": "^1.0.0"
